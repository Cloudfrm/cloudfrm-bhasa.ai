{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["src/**", "data/**"] }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "env": {
    "SUPPORT_MANAGE_LLAMA": "false"
  }
}
