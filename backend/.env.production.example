# Production (Vercel) environment variables for support-service.
#
# IMPORTANT: Vercel does NOT read this file. It's a checklist to copy into
# Project Settings -> Environment Variables by hand (or via `vercel env add`).
# Do not upload the local .env.example here — it contains localhost/llama
# settings that only work on a machine running its own llama-server.

# --- App identity / behavior (safe defaults, copy as-is) ---
SUPPORT_ASSISTANT_NAME=Bhasa
SUPPORT_CORS_ORIGINS=*
SUPPORT_MAX_NEW_TOKENS=256
SUPPORT_TEMPERATURE=0.4
SUPPORT_PIPELINE=himalaya
SUPPORT_HONORIFIC=tapai

# Locks down the API. Leave blank only if you want it open to anyone.
# If set, callers must send `x-api-key: <value>` or `Authorization: Bearer <value>`.
SUPPORT_API_KEY=

# Required so the local-llama startup code stays a no-op in serverless.
# (vercel.json also sets this, but keep it here too in case that ever changes.)
SUPPORT_MANAGE_LLAMA=false

# --- Inference backend: fill in exactly ONE of the sections below ---
# Leave INFERENCE_BACKEND=auto and the app will use whichever of these
# has a value set, in this order: your own endpoint, then Hugging Face,
# then Gemini.
INFERENCE_BACKEND=auto

# Option A: Hugging Face (router/inference API)
HF_TOKEN=

# Option B: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option C: your own OpenAI-compatible endpoint reachable from the internet
# (never a 127.0.0.1/localhost URL — Vercel's servers can't reach your machine)
INFERENCE_BASE_URL=
HIMALAYA_CHAT_MODEL=himalaya-ai/himalaya-gemma-4-e2b-it

# --- Do NOT set these in Vercel (local-dev-only, will break prod) ---
# SUPPORT_HOST, SUPPORT_PORT, HIMALAYA_GGUF_PATH, LLAMA_PORT, LLAMA_N_CTX
