SUPPORT_ASSISTANT_NAME=Bhasa
SUPPORT_HOST=127.0.0.1
SUPPORT_PORT=8088
SUPPORT_API_KEY=
# Exact-match allowlist, comma separated. Wildcards are refused.
SUPPORT_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Voice (STT/TTS) is not deployed; leave false until /v1/capabilities can honestly say otherwise.
SUPPORT_VOICE_ENABLED=false
# Dev-only state harness at /dev/states.
SUPPORT_DEV_HARNESS=false
# Source of the two byte-frozen refusal strings (fetched, never retyped).
BHASA_PROOF_URL=https://bhasa-api.fly.dev/proof/grounding_public.json

# The answer path is extractive. The settings below only drive the optional
# local Gemma runtime, which is NOT in the answer path.
INFERENCE_BACKEND=openai_compat
INFERENCE_BASE_URL=http://127.0.0.1:8081/v1
HIMALAYA_CHAT_MODEL=himalaya-gemma
HIMALAYA_GGUF_PATH=support-service/data/models/himalaya_gemma_4_q4_k_m.gguf
SUPPORT_MANAGE_LLAMA=true
LLAMA_PORT=8081
LLAMA_N_CTX=2048
SUPPORT_MAX_NEW_TOKENS=256
SUPPORT_TEMPERATURE=0.4
SUPPORT_PIPELINE=himalaya
SUPPORT_HONORIFIC=tapai
