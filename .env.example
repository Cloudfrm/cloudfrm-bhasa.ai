SUPPORT_ASSISTANT_NAME=Bhasa
SUPPORT_API_KEY=
SUPPORT_CORS_ORIGINS=*
SUPPORT_MAX_NEW_TOKENS=256
SUPPORT_TEMPERATURE=0.4
SUPPORT_PIPELINE=himalaya
SUPPORT_HONORIFIC=tapai

# --- Local dev only (a machine that runs its own llama-server) ---
# Do NOT set these in Vercel: there is no local Gemma runtime in a
# serverless deployment, and INFERENCE_BASE_URL pointing at localhost
# will make every chat request fail there.
# SUPPORT_HOST=127.0.0.1
# SUPPORT_PORT=8088
# INFERENCE_BACKEND=openai_compat
# INFERENCE_BASE_URL=http://127.0.0.1:8081/v1
# HIMALAYA_CHAT_MODEL=himalaya-gemma
# HIMALAYA_GGUF_PATH=support-service/data/models/himalaya_gemma_4_q4_k_m.gguf
# SUPPORT_MANAGE_LLAMA=true
# LLAMA_PORT=8081
# LLAMA_N_CTX=2048

# --- Required in Vercel: pick a real inference backend ---
HF_TOKEN=
GEMINI_API_KEY=
